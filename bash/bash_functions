edenv() {
    if [[ $# -eq 0 ]]; then
        error "No targets given"
        return 127
    fi
    if [[ -z ${ENVD+X} ]]; then
        error "\`\$ENVD\` hasn't been defined!" "Aborting"
        return 127
    fi
    if ! [[ -d "$ENVD" ]]; then
        error "\`$ENVD\` is not a directory!" "Aborting"
        return 127
    fi

    local TARGET="$1"
    local FPATH
    local EC=1
    for F in "$ENVD"/*.bash; do
        FPATH="$(basename "$F" | rev | cut -d '.' -f2- | rev)"
        if [[ "$FPATH" == "$TARGET" ]] || [[ "${FPATH}.bash" == "$TARGET" ]]; then
            "$EDITOR" +"cd \"$ENVD\"" "$F" && EC=0
        fi
    done
    if [[ $EC -eq 0 ]]; then
        return 0
    fi

    if [[ $TARGET =~ ^[a-zA-Z0-9_\-]+\.bash$ ]]; then
        "$EDITOR" +"cd \"$ENVD\"" "${ENVD}/$TARGET" && EC=0
    elif [[ $TARGET =~ ^[a-zA-Z0-9_\-]+$ ]]; then
        "$EDITOR" +"cd \"$ENVD\"" "${ENVD}/${TARGET}.bash" && EC=0
    fi
    return "$EC"
}
export -f edenv

gobld() {
    # If `$BUILDD` hasn't been set
    [[ -z ${BUILDD+X} ]] && return 127
    if [[ $# -eq 0 ]]; then
        pd "$BUILDD" || return 1
        return 0
    fi

    local TARGET="$BUILDD"
    local DIR FOR_SUCCESS
    while [[ $# -gt 0 ]] && [[ -d "$TARGET" ]]; do
        FOR_SUCCESS=0

        for D in $(find "$TARGET" -maxdepth 1 -type d | tail -n +2); do
            DIR="$(basename "$D")"

            if [[ "$1" == "$DIR" ]]; then
                FOR_SUCCESS=1
                TARGET="${TARGET}/${DIR}"
                shift
                break
            fi
        done

        [[ $FOR_SUCCESS -eq 0 ]] && return 1 # Failsafe
    done
    pd "$TARGET" || return 1
    return 0
}
export -f gobld


__simple_alias() {
    [[ $# -lt 2 ]] && return 127

    local ALIAS ALIAS_CMD
    while [[ $# -ge 2 ]]; do
        ALIAS="$1"
        ALIAS_CMD="$2"

        eval "alias ${ALIAS}='${ALIAS_CMD}'" || return 1
        shift 2
    done
    return 0
}
export -f __simple_alias
complete -W "" __simple_alias

__cmd_alias() {
    [[ $# -lt 3 ]] && return 127

    local ALIAS ALIAS_CMD CMD
    while [[ $# -ge 3 ]]; do
        CMD="$1"
        ALIAS="$2"
        ALIAS_CMD="$3"

        if _cmd "$CMD"; then
            __simple_alias "$ALIAS" "$ALIAS_CMD" || return 1
        fi
        shift 3
    done
    return 0
}
export -f __cmd_alias
complete -W "" __cmd_alias


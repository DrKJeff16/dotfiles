select_cc() {
    local HELP=0
    local EC=0
    local COMP=""
    if [[ $# -eq 0 ]]; then
        HELP=1
        EC=1
    fi
    if [[ "$1" =~ ^(-h|-?-help)$ ]]; then
        HELP=1
    else
        COMP="$1"
    fi
    shift

    if [[ $# -gt 0 ]] && [[ $HELP -ne 1 ]]; then
        while getopts ":h" OPTION; do
            case "$OPTION" in
                h)
                    HELP=1
                    EC=0
                    ;;
                *)
                    HELP=1
                    EC=1
                    ;;
            esac
        done
    fi
    if [[ $HELP -eq 1 ]]; then
        local TXT=(
        "select_cc"
        "  usage:    select_cc [-h]"
        "            select_cc gcc|g++|gnu|default       # CC=gcc,   CXX=g++"
        "            select_cc clang[++]|llvm            # CC=clang, CXX=clang++"
        "            select_cc cc|c++                    # CC=gcc,   CXX=g++"
        ""
    )

        if [[ $EC -eq 0 ]]; then
            printf "%s\n" "${TXT[@]}"
        else
            error "${TXT[@]}"
        fi
    else
        case "$COMP" in
            [Gg][Cc][Cc] | [Gg]"++" | [Gg][Nn][Uu])
                if _cmd 'gcc' 'g++'; then
                    export CC='gcc' CXX='g++'
                else
                    error "\`gcc\` and/or \`g++\` are not available in PATH. Aborting"
                    EC=1
                fi
                ;;
            [Cc][Ll][Aa][Nn][Gg] | [Ll][Ll][Vv][Mm] | [Cc][Ll][Aa][Nn][Gg]"++")
                if _cmd 'clang' 'clang++'; then
                    export CC='clang' CXX='clang++'
                else
                    error "\`clang\` and/or \`clang++\` are not available in PATH. Aborting"
                    EC=1
                fi
                ;;
            [Cc][Cc] | [Cc]"++")
                if _cmd 'cc' 'c++'; then
                    export CC='cc' CXX='c++'
                else
                    error "\`cc\` and/or \`c++\` are not available in PATH. Aborting"
                    EC=1
                fi
                ;;
            *) EC=1 ;;
        esac
    fi

    return "$EC"
}
export -f select_cc

# cl - `cd + ls`
#
# I forgot where I got this from.
cl() {
    if [[ $# -eq 0 ]] && [[ "$(pwd)" == "$HOME" ]]; then
        return 0
    fi

    local DIR="$1"
    DIR="${dir:=$HOME}"

    if ! [[ -d "$DIR" ]]; then
        error "bash: cl: $DIR: Directory not found"
        return 1
    fi

    cd "$DIR" &> /dev/null || return 1
    ls -A --color=auto
    return 0
}
export -f cl
complete -A directory cl


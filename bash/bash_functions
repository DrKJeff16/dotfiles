_cmd_exec() {
    [[ $# -eq 0 ]] && return 127
    ! _cmd "$1" && return 1

    local CMD_ARR=("$@")
    local CMD_STR=""
    for ARGV in "${CMD_ARR[@]}"; do
        if [[ -z "$CMD_STR" ]]; then
            CMD_STR+="$ARGV"
        else
            CMD_STR+=" $ARGV"
        fi
    done
    eval "$CMD_STR"
    return $?
}
export -f _cmd_exec

_file_not_empty() {
    [[ $# -eq 0 ]] && return 127

    _is_file "$1" || return 1
    [[ -s "$1" ]] || return 1
    return 0
}
export -f _file_not_empty
complete -A file _file_not_empty

_file_writeable() {
    [[ $# -eq 0 ]] && return 127

    _is_file "$1" || return 1
    [[ -w "$1" ]] || return 1
    return 0

_strip_from_arr() {
    if [[ $# -le 2 ]]; then
        error "No arguments passed"
        return 127
    fi

    local STRIP="$1" TARGET="$2"
    shift 2

    if [[ $TARGET =~ ^\$[a-zA-Z_][a-zA-Z0-9_]+$ ]]; then
        error "(_strip_from_arr): Second argument (TARGET) can't have a \`\$\` at the start" "Aborting"
        return 5
    fi
    if ! [[ $TARGET =~ ^[a-zA-Z_][a-zA-Z0-9_]+$ ]]; then
        error "(_strip_from_arr): Second argument ($TARGET) can't be set as variable!" "Aborting"
        return 4
    fi

    local ARR=("$@")
    eval "$TARGET=()"
    for I in "${ARR[@]}"; do
        [[ "$I" != "$STRIP" ]] && eval "$TARGET+=(\"$I\")"
    done
    eval "export $TARGET"
    return 0
}
export -f _strip_from_arr
complete -W "" _strip_from_arr

__loop_src() {
    if [[ $# -eq 0 ]]; then
        error "(__loop_src): No input given"
        return 127
    fi

    local EC=0
    local TARGET
    local ALL_ARGS=("$@")
    local RECURSIVE=0
    for ARG in "${ALL_ARGS[@]}"; do
        [[ "$ARG" == "-r" ]] && RECURSIVE=1
    done

    while [[ $# -gt 0 ]]; do
        TARGET="$1"
        if [[ $RECURSIVE -eq 1 ]] && [[ "$TARGET" == "-r" ]]; then
            shift
            continue
        fi
        if ! [[ -d "$TARGET" ]]; then
            error "\"$TARGET\" is not a directory. Skipping."
            EC=1
            shift
            continue
        fi

        for F in "$TARGET"/*; do
            if [[ $RECURSIVE -eq 0 ]] && [[ -f "$F" ]] && ! . "$F"; then
                error "(__loop_src): \`${TARGET}/${F}\` triggered an error. Aborting"
                return 2
            fi
            if [[ $RECURSIVE -eq 1 ]] && [[ -d "$F" ]]; then
                __loop_src "$F" || EC=1
            fi
        done
        shift
    done
    return "$EC"
}
export -f __loop_src
complete -A directory __loop_src

# Source given file IF AND ONLY IF it exists
__cond_src() {
    if [[ $# -eq 0 ]]; then
        error "(__cond_src): No input given"
        return 127
    fi

    local TARGET="$1"
    if ! [[ -f "$TARGET" ]]; then
        error "(__cond_src): \`$TARGET\` is not a valid file nor a directory. Aborting"
        return 127
    fi
    if [[ -d "$TARGET" ]] && [[ -n "$(ls -A1 "$TARGET")" ]]; then
        __loop_src "$TARGET" || return 1
    fi

    . "$TARGET" || return 1
    return 0
}
export -f __cond_src
complete -A file -A directory __cond_src

# Create `~/.local/...` directories
_create_dotlocals() {
    local EC=0
    for D in bin etc include lib share state var run; do
        if ! [[ -d "$HOME/.local/$D" ]]; then
            command mkdir -p "$HOME/.local/$D"
            EC=1
        fi
        [[ $EC -ne 0 ]] && break
    done
    return 0
}
export -f _create_dotlocals
complete -W "" _create_dotlocals

__append2var() {
    if [[ $# -ne 2 ]]; then
        error "(__append2var): Need TWO arguments!" "Aborting"
        return 127
    fi

    local VAR="$1"
    local QRY="$2"
    if [[ $VAR =~ ^\$.*$ ]]; then
        error "(__append2var): Variable starts with an \`\$\`!" "Aborting"
        return 3
    fi
    if eval "test -z \${${VAR}+X}"; then
        eval "export ${VAR}=\"${QRY}\""
        return $?
    fi
    if eval "echo \"\$$VAR\" | grep ':' > /dev/null 2>&1"; then
        local ARR=()
        local IFS
        IFS=$'\n' ARR=($(eval "echo \$$VAR" | sed 's/:/\n/g'))
        for V in "${ARR[@]}"; do
        [[ "$QRY" == "$V" ]] && return 1 # If `$QRY`'s value is found in the array
        done
    fi
    eval "$VAR=\"${QRY}:\${$VAR}\"" || return 1
    return 0
}
export -f __append2var
complete -W "" __append2var

__append2path() {
    [[ $# -eq 0 ]] && return 127

    __append2var "PATH" "$1" || return 1
    return 0
}

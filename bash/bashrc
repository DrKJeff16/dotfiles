#
# ~/.bashrc
#
# shellcheck shell=bash disable=SC2237,SC2016,SC2046 enable=require-double-brackets

# set -x

unset LC_COLLATE # STOP MESSING WITH MY `ls` OUTPUT!

set -o noclobber

export HISTCONTROL="erasedups:ignoreboth"
export HISTFILESIZE=36000
export HISTSIZE=32500

shopt -s histappend
shopt -s expand_aliases

_is_dir "$HOME/.build" && export BUILDD="$HOME/.build"
_is_dir "$HOME/.org" && export ORGD="$HOME/.org"
_is_dir "$HOME/.config" && export CONFD="$HOME/.config"
_is_dir "$HOME/.env.d" && export ENVD="$HOME/.env.d"
_is_dir "$HOME/Templates" && export TEMPLD="$HOME/Templates"

# Print all args `stderr`
error() {
    local TXT=("$@")
    printf "%s\n" "${TXT[@]}" >&2
    return 0
}
export -f error
complete -W "" error

# Check whether a given console command exists
_cmd() {
    if [[ $# -eq 0 ]]; then
        error "What command?"
        return 127
    fi

    while [[ $# -gt 0 ]]; do
        command -v "$1" &> /dev/null || return 1
        shift
    done
    return 0
}
export -f _cmd
complete -c _cmd

# Check whether a given console command is available in `PATH`
_cmd_which() {
    if ! _cmd 'which'; then
        error "\`which\` is not available!"
        return 1
    fi
    if [[ $# -eq 0 ]]; then
        error "What command?"
        return 127
    fi

    while [[ $# -gt 0 ]]; do
        command which "$1" &> /dev/null || return 1
        shift
    done
    return 0
}
export -f _cmd_which
complete -c _cmd_which

export FUNCFILE="$HOME/.bash_functions"

# shellcheck source=./.bash_functions
_file_readable "$FUNCFILE" && . "$FUNCFILE"

_cmd '_create_dotlocals' && _create_dotlocals

if _cmd '__append2path'; then
    for D in "$HOME/.local/bin" "$HOME/.bin" "$HOME/.bin/cbin" "$HOME/.cargo/bin"; do
        __append2path "$D"
    done
    unset D
fi

if _is_dir "$ENVD" && _cmd '__cond_src'; then
    for F in "$ENVD"/*; do
        __cond_src "$F"
    done
    unset F
fi

_is_dir "$HOME/Documents" && export DOC_D="$HOME/Documents"

export EDITOR='nano'
export VISUAL='nano'

_is_file "$HOME/.nanorc" && export NANORC="$HOME/.nanorc"
_is_file "$HOME/.tmux.conf" && export TMUX_CFG="$HOME/.tmux.conf"

_is_dir "$HOME/.nano" && export DOT_NANO="$HOME/.nano"
! _is_dir "$HOME/.cache/nano" && mkdir -p "$HOME/.cache/nano"

if _cmd 'emacs'; then
    _is_dir "$HOME/.emacs.d" && export SPC_D="$HOME/.emacs.d"
    _is_file "$HOME/.spacemacs" && export DOT_SPC="$HOME/.spacemacs"

    export EDITOR='emacs'
    export VISUAL='emacs'
fi
if _cmd 'vim'; then
    export VIMRC="$HOME/.vimrc"
    _is_dir "$HOME/.vim" && export DOT_VIM="$HOME/.vim"

    export EDITOR='vim'
    export VISUAL='vim'
fi
if _cmd 'nvim'; then
    export NVIM_CFG="$CONFD/nvim"
    export NVIM_CFG_LUA="$NVIM_CFG/lua"
    export NVIMRC="$NVIM_CFG/init.lua"
    export MANPAGER='nvim +Man!'

    export EDITOR='nvim'
    export VISUAL='nvim'
fi
export EDITOR VISUAL

export PAGER='more'
if _cmd 'less'; then
    export PAGER='less'
    export LESS='-R --use-color -Dd+g$Du+r$'
fi

if _cmd 'man'; then
    [[ -z ${MANPAGER+X} ]] && export MANPAGER="less -R --use-color -Dd+g -Du+r"

    MANPATH=""
    _is_dir /usr/man && MANPATH="/usr/man:$MANPATH"
    _is_dir /usr/share/man && MANPATH="/usr/share/man:$MANPATH"
    _is_dir /usr/local/man && MANPATH="/usr/local/man:$MANPATH"
    _is_dir /usr/local/share/man && MANPATH="/usr/local/share/man:$MANPATH"
    export MANPATH
    export MANROFFOPT="-P -c"
fi

if _cmd '__cond_src'; then
    for F in "/usr/share/bash-complete-alias/complete_alias" "/usr/share/bash-completion/bash_completion" "/usr/share/git/completion/git-completion.bash" "/usr/share/doc/pkgfile/command-not-found.bash"; do
        __cond_src "$F"
    done
    unset F
fi

export ALIASFILE="$HOME/.bash_aliases"
_is_file "$HOME/.bash_completion" && export COMPFILE="$HOME/.bash_completion"

# shellcheck source=./.bash_aliases
_file_readable "$ALIASFILE" && . "$ALIASFILE"


# shellcheck source=./.bash_completion
_file_readable "$COMPFILE" && . "$COMPFILE"

# =================================================================================================

# From here on, load the rest if in an interactive shell
[[ $- != *i* ]] && return
shopt -s checkwinsize
shopt -s no_empty_cmd_completion
export LINES COLUMNS # Export interactive shell dimensions

_cmd 'filter_histfile' && filter_histfile # Filter history, dedup it

case ${TERM} in
    xterm* | rxvt* | Eterm | aterm | kterm | gnome* | st* | tmux*)
        PROMPT_COMMAND=${PROMPT_COMMAND:+$PROMPT_COMMAND; }'printf "\033]0;%s@%s:%s\007" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"'
        ;;
    screen*)
        PROMPT_COMMAND=${PROMPT_COMMAND:+$PROMPT_COMMAND; }'printf "\033_%s@%s:%s\033\\" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"'
        ;;
esac

GPG_TTY="$(tty)"
export GPG_TTY

_cmd 'gpg-connect-agent' && gpg-connect-agent updatestartuptty /bye &> /dev/null

# If on TTY1, start Hyprland
if [[ "$(tty)" == "/dev/tty1" ]] && _cmd 'start-hyprland'; then
    if _cmd_which 'yn' || _cmd 'yn'; then
        yn "Start Hyprland?" && exec start-hyprland &> /dev/null || true
    elif _cmd '_yn'; then
        _yn "Start Hyprland? " && exec start-hyprland &> /dev/null || true
    fi
    # set +x
fi

# set +x

